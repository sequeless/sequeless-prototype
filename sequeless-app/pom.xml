<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>sequeless-app</artifactId>

  <name>sequeless-app</name>
  <description>
    Spring Boot application: REST inbound adapter, wiring, Actuator, OpenAPI, ArchUnit tests,
    end-to-end tests with Testcontainers. Depends on every other module so its ArchUnit suite
    (added in T10) sees every adapter as a reactor jar. No spring-boot-maven-plugin binding yet:
    no main class exists until T8 and binding repackage now would break verify.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-spi</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-adapter-authz-permitall</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-adapter-ontology-jena</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-adapter-persistence-postgres</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-adapter-expression-jexl</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-adapter-automation-temporal</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-adapter-automation-inprocess</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-spi-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      Not transitive from sequeless-adapter-persistence-postgres: that module declares this
      dependency <optional>true</optional>, so the application assembling the adapter must bring
      its own copy for PostgresPersistenceAutoConfiguration's JdbcClient/DataSourceTransactionManager
      and the HikariCP connection pool bits it transitively pulls in. No version here: inherited
      from the Spring Boot BOM.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!--
      No version here: the root dependencyManagement pins 3.1.1. The major version matters — the
      springdoc 3.x line is the Spring Boot 4 line, while 2.x targets Boot 3 and will not bind
      against the Boot 4.1 context this module runs in.
    -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Not transitive from sequeless-adapter-persistence-postgres: that module declares both of
      these <scope>test</scope>, so they never leave its own jar. This module's own tests need a
      real Testcontainers Postgres now that sequeless.persistence.adapter=postgres is baked into
      application.yaml (see PostgresTestcontainersSupport). No version here: inherited from the
      Spring Boot BOM, per the root pom's comment on junit-jupiter/assertj/mockito/testcontainers.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
            <configuration>
              <!--
                Without a classifier, repackage replaces this module's main artifact (the plain
                jar with classes at its root) with the executable fat jar (classes nested under
                BOOT-INF/classes/) in place, during the package phase. T14 introduced this
                module's first *IT classes: Failsafe's integration-test phase runs after package
                and puts the project's main artifact — by then the repackaged fat jar — on the
                test classpath instead of target/classes, so every class under
                org.sequeless.app.rest.* (nested under BOOT-INF/classes/ in that jar) becomes a
                NoClassDefFoundError. Giving the executable jar its own classifier leaves the
                plain jar as the main artifact, so Failsafe's classpath is unaffected.
              -->
              <classifier>exec</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
