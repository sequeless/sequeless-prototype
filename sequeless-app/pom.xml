<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>sequeless-app</artifactId>

  <name>sequeless-app</name>
  <description>
    Spring Boot application: REST inbound adapter, wiring, Actuator, OpenAPI, ArchUnit tests,
    end-to-end tests with Testcontainers. Depends on every other module so its ArchUnit suite
    (added in T10) sees every adapter as a reactor jar. No spring-boot-maven-plugin binding yet:
    no main class exists until T8 and binding repackage now would break verify.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-spi</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-adapter-authz-permitall</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-adapter-ontology-jena</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-adapter-persistence-postgres</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-adapter-expression-jexl</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-adapter-automation-temporal</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-adapter-automation-inprocess</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-spi-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
