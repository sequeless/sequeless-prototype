<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-prototype</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>sequeless-adapter-persistence-postgres</artifactId>

  <name>sequeless-adapter-persistence-postgres</name>
  <description>Holds PostgresOntologyDocumentStore, the prototype's ontology document store over sq_ontology_document, and its
    contract test. The rest of the Postgres wiring moved to sequeless-app in spec 18 U12a, and the store adapter is the
    released sequeless-store. This module is deleted in U14, when sequeless-ontology owns the document store.</description>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-core</artifactId>
    </dependency>

    <!--
      Spec 18 U11: the Command side is the released sequeless-store. The Command adapter's classes (PostgresMigrations and
      the SQL included) come from store-postgres-jsonb-adapter. No version: the BOM manages it.
    -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>store-postgres-jsonb-adapter</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>

    <!--
      Kept as a normal (non-optional) runtime dependency: the contract test runs the store's migrations over the
      container's DataSource, so the driver must be on the runtime classpath. Flyway comes transitively from the store.
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Spec 18 U11: the composed migrate (command, then the Query set, then command V7 onward) runs the Query set through the
      released query-postgres-jsonb-adapter's own migrate. The contract test passes that migrate as the hook, so the jar is a
      test dependency here.
    -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>query-postgres-jsonb-adapter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-testfixtures</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>analyze-only</id>
            <configuration>
              <!--
                The Spring Boot starter entry is the parent's own ignore, repeated because a child list replaces
                the parent's list.
              -->
              <ignoredUnusedDeclaredDependencies>
                <ignoredUnusedDeclaredDependency>org.springframework.boot:spring-boot-starter*</ignoredUnusedDeclaredDependency>
              </ignoredUnusedDeclaredDependencies>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
