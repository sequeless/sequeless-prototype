<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>sequeless-adapter-persistence-postgres</artifactId>

  <name>sequeless-adapter-persistence-postgres</name>
  <description>
    Shell module for the default ObjectStorePort and QueryPort adapter: PostgreSQL 18 JSONB storage,
    Flyway migrations, the transactional outbox table, and hint-driven indexes. JDBC/Flyway
    dependencies arrive in Phase 2; for now this module only proves the reactor wiring and toolchain.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-spi</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      Optional: this module's own PostgresObjectStore/PostgresOntologyDocumentStore classes depend
      on JdbcClient/TransactionTemplate, but a caller that only wants those plain classes against a
      hand-built DataSource must not be forced to pull Spring Boot's autoconfigure machinery.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!--
      This is a Jackson-3 codebase (tools.jackson, not com.fasterxml.jackson): Boot 4.1.1's own
      spring-boot-starter-web pulls tools.jackson.core:jackson-databind 3.x. This module does not
      depend on spring-boot-starter-web, so it declares jackson-databind directly; ValueJsonCodec
      must only ever import tools.jackson.databind.*, never com.fasterxml.jackson.databind.*.
    -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!--
      Kept as a normal (non-optional) compile dependency: this adapter's own Flyway.configure()
      call needs the driver on its classpath at runtime regardless of who assembles the app, and
      spring-boot-starter-jdbc does not itself pull a driver.
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-spi-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
      Unlike sequeless-adapter-ontology-jena/sequeless-adapter-authz-permitall's reflection-only
      auto-configuration tests, PostgresPersistenceAutoConfigurationTest exercises a real Spring
      context via ApplicationContextRunner (see plan.md/steps-phase-2.md T6), so this module needs
      spring-boot-test on its test classpath.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
