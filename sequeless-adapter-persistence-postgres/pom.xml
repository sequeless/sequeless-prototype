<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-prototype</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>sequeless-adapter-persistence-postgres</artifactId>

  <name>sequeless-adapter-persistence-postgres</name>
  <description>Shell module for the default ObjectStorePort and QueryPort adapter: PostgreSQL 18 JSONB storage,
    Flyway migrations, the transactional outbox table, and hint-driven indexes. JDBC/Flyway
    dependencies arrive in Phase 2; for now this module only proves the reactor wiring and toolchain.</description>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>kernel-identity</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-core</artifactId>
    </dependency>

    <!--
      Spec 18 U11: the Command side is the released sequeless-store. The host's wiring (autoconfiguration, properties,
      the adapter descriptor, the migrating DataSource) builds and migrates the store's Postgres adapter, so both
      store modules are compile dependencies here. No version: the BOM manages them.
    -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>store-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>store-postgres-jsonb-adapter</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      Optional: the wiring and this module's PostgresOntologyDocumentStore depend on JdbcClient and
      TransactionTemplate, but a caller that only wants the plain store classes against a hand-built
      DataSource must not be forced to pull Spring Boot's autoconfigure machinery.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Spec 18 U11: the migrations run through the store's and the query adapter's own Flyway; the host's tests drive Flyway directly. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The Query port's lambda in the autoconfiguration takes the released Schema type, so the module names it at compile scope. -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>schema-contract</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Kept as a normal (non-optional) runtime dependency: the migrations run over this module's DataSource, so the
      driver must be on the classpath whoever assembles the app, and spring-boot-starter-jdbc does not pull a driver.
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>ontology-testfixtures</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Spec 18 U11: the host's composed migrate (command, then the Query set, then command V7 onward) runs the Query set
      through the released query-postgres-jsonb-adapter's own migrate, on flyway_schema_history_query. So the jar is a
      compile dependency here, and the host's migration tests run the real Query set.
    -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>query-postgres-jsonb-adapter</artifactId>
    </dependency>

    <!-- Test runtime from the Spring Boot test starter. -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>

    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-tx</artifactId>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>analyze-only</id>
            <configuration>
              <!--
                The Spring Boot starter entry is the parent's own ignore, repeated because a child list replaces
                the parent's list.
              -->
              <ignoredUnusedDeclaredDependencies>
                <ignoredUnusedDeclaredDependency>org.springframework.boot:spring-boot-starter*</ignoredUnusedDeclaredDependency>
              </ignoredUnusedDeclaredDependencies>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
