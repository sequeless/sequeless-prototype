@prefix sq:   <https://sequeless.dev/ns/meta#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#
# Canonical Turtle declaration of the sq: vocabulary (see docs/architecture/sq-vocabulary.md, T1).
# Any ontology document that uses sq: terms imports this document via
# owl:imports <https://sequeless.dev/ns/meta>.
#

<https://sequeless.dev/ns/meta>
    a owl:Ontology .

sq:label
    a owl:AnnotationProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Domain is the union of owl:Class and rdf:Property (both TypeDefinition and PropertyDefinition carry a label); OWL2 cannot express a class/property union domain on an annotation property, so it is recorded here rather than as an rdfs:domain axiom. Overrides rdfs:label where both are present on the same subject." .

sq:displayOrder
    a owl:AnnotationProperty ;
    rdfs:range xsd:integer ;
    rdfs:comment "Domain is the union of owl:Class and rdf:Property, for the same reason as sq:label; see that term's comment." .

sq:displayGroup
    a owl:AnnotationProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "Domain is the union of owl:Class and rdf:Property, for the same reason as sq:label; see that term's comment." .

sq:hidden
    a owl:AnnotationProperty ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Domain is the union of owl:Class and rdf:Property, for the same reason as sq:label; see that term's comment." .

sq:facet
    a owl:AnnotationProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:boolean .

sq:indexed
    a owl:AnnotationProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:boolean .

sq:searchable
    a owl:AnnotationProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:boolean .

sq:readOnly
    a owl:AnnotationProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:boolean .

sq:displayLabel
    a owl:AnnotationProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:boolean .

sq:abstract
    a owl:AnnotationProperty ;
    rdfs:domain owl:Class ;
    rdfs:range xsd:boolean .

#
# Derived properties (sq:Rollup / sq:Plugin) — Phase 4 (docs/architecture/sq-vocabulary.md,
# "Terms in use (phase 4)"). Every term below is deliberately declared owl:AnnotationProperty,
# never owl:ObjectProperty or owl:DatatypeProperty: SnapshotMapper's property attribution walks
# OntDataProperty/OntObjectProperty only, so an annotation property never surfaces as a property
# of a type — these terms describe a derivation rule attached to a property, not a property of
# the domain type themselves. Do not "fix" this by upgrading them.
#

sq:derivedBy
    a owl:AnnotationProperty ;
    rdfs:domain rdf:Property ;
    rdfs:comment "Range is really the union of sq:Rollup and sq:Plugin (a derivation is a declarative rollup or a named plugin, never both); RDFS cannot express a union range on an annotation property, so it is recorded here rather than as an rdfs:range axiom — the same limitation sq:label's comment records for its union domain. Deliberately no rdfs:range is asserted for either arm of that union: asserting just sq:Rollup (as this term once did) lets a rule-based reasoner (ReasonerSetting.OWL/RDFS) entail rdf:type sq:Rollup onto every sq:derivedBy object via the standard rdfs:range rule, including genuine sq:Plugin nodes — silently breaking SnapshotMapper's mutual-exclusion check between the two rule kinds. Presence of sq:derivedBy on a property forces PropertyDefinition.readOnly() true regardless of sq:readOnly." .

sq:Rollup
    a owl:Class ;
    rdfs:comment "A declarative aggregate: sq:function applied over instances of sq:over reached via sq:via, using sq:of as the aggregated property (absent for sq:count), optionally narrowed by sq:filter." .

sq:Plugin
    a owl:Class ;
    rdfs:comment "A derivation implemented in code and looked up by sq:pluginName via ServiceLoader against org.sequeless.spi.derivation.DerivationPlugin." .

sq:Criterion
    a owl:Class ;
    rdfs:comment "A single filter condition inside an sq:filter list: sq:property sq:operator sq:value." .

sq:function
    a owl:AnnotationProperty ;
    rdfs:domain sq:Rollup ;
    rdfs:comment "Legal values are the five function individuals declared below (sq:count, sq:sum, sq:min, sq:max, sq:avg); this is a fixed enumeration that RDFS cannot express without owl:oneOf, so no rdfs:range is asserted and the set is validated at snapshot activation instead." .

sq:over
    a owl:AnnotationProperty ;
    rdfs:domain sq:Rollup ;
    rdfs:range owl:Class .

sq:via
    a owl:AnnotationProperty ;
    rdfs:domain sq:Rollup ;
    rdfs:range rdf:Property .

sq:of
    a owl:AnnotationProperty ;
    rdfs:domain sq:Rollup ;
    rdfs:range rdf:Property ;
    rdfs:comment "Absent for sq:count." .

sq:filter
    a owl:AnnotationProperty ;
    rdfs:domain sq:Rollup ;
    rdfs:range rdf:List ;
    rdfs:comment "An RDF list of sq:Criterion nodes." .

sq:property
    a owl:AnnotationProperty ;
    rdfs:domain sq:Criterion ;
    rdfs:range rdf:Property .

sq:operator
    a owl:AnnotationProperty ;
    rdfs:domain sq:Criterion ;
    rdfs:comment "Legal values are the eleven operator individuals declared below, mirroring org.sequeless.spi.query.Operator; this is a fixed enumeration that RDFS cannot express without owl:oneOf, so no rdfs:range is asserted and the set is validated at snapshot activation instead." .

sq:value
    a owl:AnnotationProperty ;
    rdfs:domain sq:Criterion ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Absent for sq:isNull/sq:notNull." .

sq:pluginName
    a owl:AnnotationProperty ;
    rdfs:domain sq:Plugin ;
    rdfs:range xsd:string .

#
# Function individuals — mirror org.sequeless.spi.meta.AggregateFunction; matched by IRI local
# name against the enum's constant names.
#

sq:count a owl:NamedIndividual .

sq:sum a owl:NamedIndividual .

sq:min a owl:NamedIndividual .

sq:max a owl:NamedIndividual .

sq:avg a owl:NamedIndividual .

#
# Operator individuals — mirror org.sequeless.spi.query.Operator; matched by IRI local name
# against the enum's constant names.
#

sq:eq a owl:NamedIndividual .

sq:ne a owl:NamedIndividual .

sq:in a owl:NamedIndividual .

sq:lt a owl:NamedIndividual .

sq:lte a owl:NamedIndividual .

sq:gt a owl:NamedIndividual .

sq:gte a owl:NamedIndividual .

sq:contains a owl:NamedIndividual .

sq:startsWith a owl:NamedIndividual .

sq:isNull a owl:NamedIndividual .

sq:notNull a owl:NamedIndividual .
