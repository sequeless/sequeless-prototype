@prefix ex:   <https://sequeless.dev/ns/ref#> .
@prefix sq:   <https://sequeless.dev/ns/meta#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

#
# reference.ttl plus one sq:Plugin-derived property, ex:workload on ex:Person, whose sq:pluginName
# ("does-not-exist") matches no registered org.sequeless.spi.derivation.DerivationPlugin on the
# classpath -- unlike reference-plugin.ttl's "workload", which the sample WorkloadDerivationPlugin
# does register. Exists to prove ontology activation fails, at startup, on an unresolvable
# sq:pluginName (T4's ServiceLoader-backed check in JenaOntologyPort.buildStateFrom). Distinct
# filename (and, at the app level, distinct classpath resource) from reference.ttl and
# reference-plugin.ttl on purpose: sequeless-app and sequeless-spi-testkit both put resources under
# ontology/, so reusing a shared filename would make a classpath lookup ambiguous and
# order-dependent.
#
# Reference-domain ontology used across the contract testkit and the Jena adapter's own tests.
# Deliverable is abstract and superclasses WorkItem, which is itself abstract and superclasses the
# concrete Task and Project types. Person stands alone. The three-level hierarchy is intentional:
# it is what makes the reasoner=none / rdfs / owl distinction on superTypes() observable.
#
# status (on WorkItem), priority/dueDate (on Task), and name (on Person) each carry an explicit
# owl:maxCardinality 1 restriction (T13): DefaultBusinessObjectService's filter/sort/facet
# resolution and PostgresQueryStore's per-datatype JSONB extraction both require a scalar
# (cardinality max 1) property, since ValueCoercer stores anything else as a JSON list rather than
# a bare tagged value. Without this, filtering/sorting/faceting on these properties through the
# REST API (and the assignedTo facet's Person.name display-label resolution, which reads target.
# props ->> 'text' the same way) is unreachable even though the property itself is sq:facet/
# sq:indexed. estimatedHours (on Task) gained the same restriction in Phase 4 (derived properties,
# T5): ex:totalEstimatedHours below is a sq:Rollup that sums it with SQL sum(), which needs
# ValueCoercer to have stored a bare tagged value ({"decimal": ...}) rather than a JSON list, for
# exactly the reason filter/sort/facet resolution does above. title/description remain
# deliberately unrestricted (max unbounded) — nothing filters/sorts/facets/aggregates on them, and
# existing tests (F39) rely on posting them as JSON lists.
#
# ex:Project also declares two Phase 4 derived properties, openTaskCount and totalEstimatedHours:
# both are sq:Rollup-derived, computed on read from ex:Task via ex:belongsToProject, and never
# stored in props. Declaring sq:derivedBy forces PropertyDefinition.readOnly() true regardless of
# sq:readOnly, and both carry an owl:maxCardinality 1 restriction so they render as scalars, the
# same way status does above. See docs/architecture/sq-vocabulary.md for the sq:Rollup vocabulary.
#

<https://sequeless.dev/ns/ref>
    a owl:Ontology ;
    owl:imports <https://sequeless.dev/ns/meta> .

#
# Classes
#

ex:Deliverable
    a owl:Class ;
    sq:label "Deliverable" ;
    sq:abstract "true"^^xsd:boolean .

ex:WorkItem
    a owl:Class ;
    rdfs:subClassOf ex:Deliverable ,
        [ a owl:Restriction ;
          owl:onProperty ex:status ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    sq:label "Work Item" ;
    sq:abstract "true"^^xsd:boolean .

ex:Task
    a owl:Class ;
    rdfs:subClassOf ex:WorkItem ,
        [ a owl:Restriction ;
          owl:onProperty ex:title ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:assignedTo ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:priority ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:dueDate ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:estimatedHours ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    sq:label "Task" .

ex:Project
    a owl:Class ;
    rdfs:subClassOf ex:WorkItem ,
        [ a owl:Restriction ;
          owl:onProperty ex:openTaskCount ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:totalEstimatedHours ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    sq:label "Project" .

ex:Person
    a owl:Class ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty ex:name ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:name ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:workload ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    sq:label "Person" .

#
# Properties
#

ex:title
    a owl:DatatypeProperty ;
    rdfs:domain ex:Deliverable ;
    rdfs:range xsd:string ;
    sq:label "Title" ;
    sq:searchable "true"^^xsd:boolean ;
    sq:displayLabel "true"^^xsd:boolean ;
    sq:displayGroup "General" ;
    sq:displayOrder "1"^^xsd:integer .

ex:status
    a owl:DatatypeProperty ;
    rdfs:domain ex:WorkItem ;
    rdfs:range xsd:string ;
    sq:label "Status" ;
    sq:facet "true"^^xsd:boolean ;
    sq:indexed "true"^^xsd:boolean ;
    sq:displayOrder "2"^^xsd:integer .

ex:priority
    a owl:DatatypeProperty ;
    rdfs:domain ex:Task ;
    rdfs:range xsd:integer ;
    sq:label "Priority" ;
    sq:displayGroup "Planning" ;
    sq:displayOrder "3"^^xsd:integer .

ex:createdAt
    a owl:DatatypeProperty ;
    rdfs:domain ex:Deliverable ;
    rdfs:range xsd:dateTime ;
    sq:label "Created At" ;
    sq:hidden "true"^^xsd:boolean ;
    sq:readOnly "true"^^xsd:boolean ;
    sq:displayOrder "6"^^xsd:integer .

ex:estimatedHours
    a owl:DatatypeProperty ;
    rdfs:domain ex:Task ;
    rdfs:range xsd:decimal ;
    sq:label "Estimated Hours" ;
    sq:displayOrder "7"^^xsd:integer .

ex:dueDate
    a owl:DatatypeProperty ;
    rdfs:domain ex:Task ;
    rdfs:range xsd:date ;
    sq:label "Due Date" ;
    sq:displayOrder "8"^^xsd:integer .

ex:description
    a owl:DatatypeProperty ;
    rdfs:domain ex:WorkItem ;
    rdfs:range xsd:string ;
    sq:label "Description" ;
    sq:searchable "true"^^xsd:boolean ;
    sq:displayGroup "General" ;
    sq:displayOrder "9"^^xsd:integer .

ex:assignedTo
    a owl:ObjectProperty ;
    rdfs:domain ex:Task ;
    rdfs:range ex:Person ;
    sq:label "Assigned To" ;
    sq:facet "true"^^xsd:boolean ;
    sq:displayOrder "4"^^xsd:integer .

ex:belongsToProject
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain ex:Task ;
    rdfs:range ex:Project ;
    owl:inverseOf ex:hasTask ;
    sq:label "Belongs To Project" ;
    sq:displayOrder "5"^^xsd:integer .

ex:hasTask
    a owl:ObjectProperty ;
    rdfs:domain ex:Project ;
    rdfs:range ex:Task ;
    sq:label "Has Task" ;
    sq:displayOrder "2"^^xsd:integer .

ex:name
    a owl:DatatypeProperty ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:string ;
    sq:label "Name" ;
    sq:displayLabel "true"^^xsd:boolean ;
    sq:displayOrder "1"^^xsd:integer .

ex:email
    a owl:DatatypeProperty ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:string ;
    sq:label "Email" ;
    sq:displayOrder "2"^^xsd:integer .

#
# Derived properties (Phase 4, DR-08) — computed on read from ex:Task, never stored in props.
#

ex:openTaskCount
    a owl:DatatypeProperty ;
    rdfs:domain ex:Project ;
    rdfs:range xsd:integer ;
    sq:label "Open Tasks" ;
    sq:displayOrder "3"^^xsd:integer ;
    sq:derivedBy [
        a sq:Rollup ;
        sq:function sq:count ;
        sq:over ex:Task ;
        sq:via ex:belongsToProject ;
        sq:filter ( [ a sq:Criterion ;
                      sq:property ex:status ;
                      sq:operator sq:ne ;
                      sq:value "done" ] ) ] .

ex:totalEstimatedHours
    a owl:DatatypeProperty ;
    rdfs:domain ex:Project ;
    rdfs:range xsd:decimal ;
    sq:label "Total Estimated Hours" ;
    sq:displayOrder "4"^^xsd:integer ;
    sq:derivedBy [
        a sq:Rollup ;
        sq:function sq:sum ;
        sq:over ex:Task ;
        sq:via ex:belongsToProject ;
        sq:of ex:estimatedHours ] .

#
# Derived property backed by a code plug-in rather than a declarative rollup (Phase 4, DR-08):
# dispatches by name to a registered org.sequeless.spi.derivation.DerivationPlugin, exactly as
# ex:openTaskCount/ex:totalEstimatedHours above dispatch to a declarative sq:Rollup.
#

ex:workload
    a owl:DatatypeProperty ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:decimal ;
    sq:label "Workload" ;
    sq:displayOrder "3"^^xsd:integer ;
    sq:derivedBy [ a sq:Plugin ; sq:pluginName "does-not-exist" ] .

#
# SHACL shapes
#

ex:TaskShape
    a sh:NodeShape ;
    sh:targetClass ex:Task ;
    sh:property [
        sh:path ex:estimatedHours ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1000 ;
    ] .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetClass ex:Person ;
    sh:property [
        sh:path ex:email ;
        sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ;
    ] .
