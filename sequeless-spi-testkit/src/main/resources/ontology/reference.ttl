@prefix ex:   <https://sequeless.dev/ns/ref#> .
@prefix sq:   <https://sequeless.dev/ns/meta#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

#
# Reference-domain ontology used across the contract testkit and the Jena adapter's own tests.
# Deliverable is abstract and superclasses WorkItem, which is itself abstract and superclasses the
# concrete Task and Project types. Person stands alone. The three-level hierarchy is intentional:
# it is what makes the reasoner=none / rdfs / owl distinction on superTypes() observable.
#
# status (on WorkItem), priority/dueDate (on Task), and name (on Person) each carry an explicit
# owl:maxCardinality 1 restriction (T13): DefaultBusinessObjectService's filter/sort/facet
# resolution and PostgresQueryStore's per-datatype JSONB extraction both require a scalar
# (cardinality max 1) property, since ValueCoercer stores anything else as a JSON list rather than
# a bare tagged value. Without this, filtering/sorting/faceting on these properties through the
# REST API (and the assignedTo facet's Person.name display-label resolution, which reads target.
# props ->> 'text' the same way) is unreachable even though the property itself is sq:facet/
# sq:indexed. estimatedHours (on Task) gained the same restriction in Phase 4 (derived properties,
# T5): ex:totalEstimatedHours below is a sq:Rollup that sums it with SQL sum(), which needs
# ValueCoercer to have stored a bare tagged value ({"decimal": ...}) rather than a JSON list, for
# exactly the reason filter/sort/facet resolution does above. title/description remain
# deliberately unrestricted (max unbounded) — nothing filters/sorts/facets/aggregates on them, and
# existing tests (F39) rely on posting them as JSON lists.
#
# ex:Project also declares two Phase 4 derived properties, openTaskCount and totalEstimatedHours:
# both are sq:Rollup-derived, computed on read from ex:Task via ex:belongsToProject, and never
# stored in props. Declaring sq:derivedBy forces PropertyDefinition.readOnly() true regardless of
# sq:readOnly, and both carry an owl:maxCardinality 1 restriction so they render as scalars, the
# same way status does above. See docs/architecture/sq-vocabulary.md for the sq:Rollup vocabulary.
#

<https://sequeless.dev/ns/ref>
    a owl:Ontology ;
    owl:imports <https://sequeless.dev/ns/meta> .

#
# Classes
#

ex:Deliverable
    a owl:Class ;
    sq:label "Deliverable" ;
    sq:abstract "true"^^xsd:boolean .

ex:WorkItem
    a owl:Class ;
    rdfs:subClassOf ex:Deliverable ,
        [ a owl:Restriction ;
          owl:onProperty ex:status ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    sq:label "Work Item" ;
    sq:abstract "true"^^xsd:boolean .

ex:Task
    a owl:Class ;
    rdfs:subClassOf ex:WorkItem ,
        [ a owl:Restriction ;
          owl:onProperty ex:title ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:assignedTo ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:priority ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:dueDate ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:estimatedHours ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    sq:label "Task" .

ex:Project
    a owl:Class ;
    rdfs:subClassOf ex:WorkItem ,
        [ a owl:Restriction ;
          owl:onProperty ex:openTaskCount ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:totalEstimatedHours ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:owner ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    sq:label "Project" .

ex:Person
    a owl:Class ;
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty ex:name ;
          owl:minCardinality "1"^^xsd:nonNegativeInteger ] ,
        [ a owl:Restriction ;
          owl:onProperty ex:name ;
          owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ;
    sq:label "Person" .

#
# Properties
#

ex:title
    a owl:DatatypeProperty ;
    rdfs:domain ex:Deliverable ;
    rdfs:range xsd:string ;
    sq:label "Title" ;
    sq:searchable "true"^^xsd:boolean ;
    sq:displayLabel "true"^^xsd:boolean ;
    sq:displayGroup "General" ;
    sq:displayOrder "1"^^xsd:integer .

ex:status
    a owl:DatatypeProperty ;
    rdfs:domain ex:WorkItem ;
    rdfs:range xsd:string ;
    sq:label "Status" ;
    sq:facet "true"^^xsd:boolean ;
    sq:indexed "true"^^xsd:boolean ;
    sq:displayOrder "2"^^xsd:integer .

ex:priority
    a owl:DatatypeProperty ;
    rdfs:domain ex:Task ;
    rdfs:range xsd:integer ;
    sq:label "Priority" ;
    sq:displayGroup "Planning" ;
    sq:displayOrder "3"^^xsd:integer .

ex:createdAt
    a owl:DatatypeProperty ;
    rdfs:domain ex:Deliverable ;
    rdfs:range xsd:dateTime ;
    sq:label "Created At" ;
    sq:hidden "true"^^xsd:boolean ;
    sq:readOnly "true"^^xsd:boolean ;
    sq:displayOrder "6"^^xsd:integer .

ex:estimatedHours
    a owl:DatatypeProperty ;
    rdfs:domain ex:Task ;
    rdfs:range xsd:decimal ;
    sq:label "Estimated Hours" ;
    sq:displayOrder "7"^^xsd:integer .

ex:dueDate
    a owl:DatatypeProperty ;
    rdfs:domain ex:Task ;
    rdfs:range xsd:date ;
    sq:label "Due Date" ;
    sq:displayOrder "8"^^xsd:integer .

ex:description
    a owl:DatatypeProperty ;
    rdfs:domain ex:WorkItem ;
    rdfs:range xsd:string ;
    sq:label "Description" ;
    sq:searchable "true"^^xsd:boolean ;
    sq:displayGroup "General" ;
    sq:displayOrder "9"^^xsd:integer .

ex:assignedTo
    a owl:ObjectProperty ;
    rdfs:domain ex:Task ;
    rdfs:range ex:Person ;
    sq:label "Assigned To" ;
    sq:facet "true"^^xsd:boolean ;
    sq:displayOrder "4"^^xsd:integer .

ex:belongsToProject
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain ex:Task ;
    rdfs:range ex:Project ;
    owl:inverseOf ex:hasTask ;
    sq:label "Belongs To Project" ;
    sq:displayOrder "5"^^xsd:integer .

ex:hasTask
    a owl:ObjectProperty ;
    rdfs:domain ex:Project ;
    rdfs:range ex:Task ;
    sq:label "Has Task" ;
    sq:displayOrder "2"^^xsd:integer .

ex:owner
    a owl:ObjectProperty ;
    rdfs:domain ex:Project ;
    rdfs:range ex:Person ;
    sq:label "Owner" ;
    sq:displayOrder "6"^^xsd:integer .

ex:name
    a owl:DatatypeProperty ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:string ;
    sq:label "Name" ;
    sq:displayLabel "true"^^xsd:boolean ;
    sq:displayOrder "1"^^xsd:integer .

ex:email
    a owl:DatatypeProperty ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:string ;
    sq:label "Email" ;
    sq:displayOrder "2"^^xsd:integer .

#
# Derived properties (Phase 4, DR-08) — computed on read from ex:Task, never stored in props.
# ex:openTaskCount is additionally sq:materialised (Phase 6): its value is *also* kept correct in
# sq_object.props from domain events, so it is filterable/sortable (filter[openTaskCount][eq]=0),
# while GET/browse still always return the freshly recomputed aggregate above, never the stored
# value. ex:totalEstimatedHours is deliberately left non-materialised, to exercise the 400
# rejection path for filtering/sorting an un-materialised derived property.
#

ex:openTaskCount
    a owl:DatatypeProperty ;
    rdfs:domain ex:Project ;
    rdfs:range xsd:integer ;
    sq:label "Open Tasks" ;
    sq:displayOrder "3"^^xsd:integer ;
    sq:derivedBy [
        a sq:Rollup ;
        sq:function sq:count ;
        sq:over ex:Task ;
        sq:via ex:belongsToProject ;
        sq:filter ( [ a sq:Criterion ;
                      sq:property ex:status ;
                      sq:operator sq:ne ;
                      sq:value "done" ] ) ;
        sq:materialised true ] .

ex:totalEstimatedHours
    a owl:DatatypeProperty ;
    rdfs:domain ex:Project ;
    rdfs:range xsd:decimal ;
    sq:label "Total Estimated Hours" ;
    sq:displayOrder "4"^^xsd:integer ;
    sq:derivedBy [
        a sq:Rollup ;
        sq:function sq:sum ;
        sq:over ex:Task ;
        sq:via ex:belongsToProject ;
        sq:of ex:estimatedHours ] .

#
# State machine (Phase 5, DR-09; automated triggers added Phase 6, DR-11) — ex:Project moves
# Draft -> Active -> OnHold/Closed, plus Closed -> Active. `activate`, `hold`, `resume`, and
# `close` are sq:UserAction, fired only by a REST caller. `activate` is the only transition with a
# guard (self.owner != null) and the only one with actions, so it exercises both mechanisms an
# ExpressionPort implementation (a later task) must support: sq:expression on
# sq:SetProperty/sq:PropertyAssignment nodes is bare JEXL source (no ${} — the whole string is the
# expression), while sq:url/sq:body on sq:Webhook are JXLT templates (${expr} placeholders spliced
# into an otherwise-literal string). `hold`, `resume`, and `close` deliberately carry no sq:guard,
# to exercise the "always available" path.
#
# The three remaining transitions each exercise one of the other three sq:trigger kinds and fire
# without any user request, through the same guard -> commit -> action path `fire` uses:
#   - `autoClose` (sq:OnChange, sq:watch ex:belongsToProject) reacts to any ex:Task that points
#     back at this ex:Project changing, and moves Active -> Closed once self.openTaskCount == 0 —
#     the very reason ex:openTaskCount is sq:materialised above, since the guard reads it from
#     stored props, not by recomputing it inline.
#   - `expireHold` (sq:Timer, sq:after "PT72H") moves OnHold -> Closed 72 hours after the object
#     entered OnHold; the duration is ontology data, editable without a rebuild.
#   - `reopen` (sq:ExternalSignal, sq:signalName "reopen") moves Closed -> Active in response to a
#     POST /objects/Project/{id}/signals/reopen call naming that signal.
#
# Every expression here only reaches into the ExpressionContext shape a later task will define
# (self's own properties, self's current state, and the acting principal) — e.g. self.owner,
# self.title, self.openTaskCount — never a property (like self.id) that shape won't carry.
#

ex:ProjectLifecycle
    a sq:StateMachine ;
    sq:appliesTo ex:Project ;
    sq:initialState ex:Draft ;
    sq:state ex:Draft, ex:Active, ex:OnHold, ex:Closed ;
    sq:transition
        [ a sq:Transition ;
          sq:name "activate" ;
          sq:from ex:Draft ; sq:to ex:Active ;
          sq:trigger sq:UserAction ;
          sq:guard "self.owner != null" ;
          sq:guardMessage "Project must have an owner before it can be activated" ;
          sq:action
            ( [ a sq:CreateObject ;
                sq:type ex:Task ;
                sq:properties
                  ( [ a sq:PropertyAssignment ;
                      sq:property ex:title ;
                      sq:expression "'Kickoff: ' + self.title" ] ) ]
              [ a sq:Webhook ;
                sq:url "https://example.org/hooks/project-activated" ;
                sq:method "POST" ;
                sq:body "{\"project\": \"${self.title}\"}" ] ) ] ,
        [ a sq:Transition ; sq:name "hold" ;   sq:from ex:Active ; sq:to ex:OnHold ; sq:trigger sq:UserAction ] ,
        [ a sq:Transition ; sq:name "resume" ; sq:from ex:OnHold ; sq:to ex:Active ; sq:trigger sq:UserAction ] ,
        [ a sq:Transition ; sq:name "close" ;  sq:from ex:Active ; sq:to ex:Closed ; sq:trigger sq:UserAction ] ,
        [ a sq:Transition ; sq:name "autoClose" ;
          sq:from ex:Active ; sq:to ex:Closed ;
          sq:trigger sq:OnChange ; sq:watch ex:belongsToProject ;
          sq:guard "self.openTaskCount == 0" ;
          sq:guardMessage "Project still has open tasks" ] ,
        [ a sq:Transition ; sq:name "expireHold" ;
          sq:from ex:OnHold ; sq:to ex:Closed ;
          sq:trigger sq:Timer ; sq:after "PT72H" ] ,
        [ a sq:Transition ; sq:name "reopen" ;
          sq:from ex:Closed ; sq:to ex:Active ;
          sq:trigger sq:ExternalSignal ; sq:signalName "reopen" ] .

ex:Draft  a sq:State ; sq:label "Draft"   ; sq:displayOrder "1"^^xsd:integer .
ex:Active a sq:State ; sq:label "Active"  ; sq:displayOrder "2"^^xsd:integer .
ex:OnHold a sq:State ; sq:label "On Hold" ; sq:displayOrder "3"^^xsd:integer .
ex:Closed a sq:State ; sq:label "Closed"  ; sq:displayOrder "4"^^xsd:integer .

#
# SHACL shapes
#

ex:TaskShape
    a sh:NodeShape ;
    sh:targetClass ex:Task ;
    sh:property [
        sh:path ex:estimatedHours ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1000 ;
    ] .

ex:PersonShape
    a sh:NodeShape ;
    sh:targetClass ex:Person ;
    sh:property [
        sh:path ex:email ;
        sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ;
    ] .
