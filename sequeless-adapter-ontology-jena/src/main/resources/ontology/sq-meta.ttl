@prefix sq:   <https://sequeless.dev/ns/meta#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#
# Canonical Turtle declaration of the sq: vocabulary (see docs/architecture/sq-vocabulary.md, T1).
# Any ontology document that uses sq: terms imports this document via
# owl:imports <https://sequeless.dev/ns/meta>.
#

<https://sequeless.dev/ns/meta>
    a owl:Ontology .

sq:label
    a owl:AnnotationProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Domain is the union of owl:Class and rdf:Property (both TypeDefinition and PropertyDefinition carry a label); OWL2 cannot express a class/property union domain on an annotation property, so it is recorded here rather than as an rdfs:domain axiom. Overrides rdfs:label where both are present on the same subject." .

sq:displayOrder
    a owl:AnnotationProperty ;
    rdfs:range xsd:integer ;
    rdfs:comment "Domain is the union of owl:Class and rdf:Property, for the same reason as sq:label; see that term's comment." .

sq:displayGroup
    a owl:AnnotationProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "Domain is the union of owl:Class and rdf:Property, for the same reason as sq:label; see that term's comment." .

sq:hidden
    a owl:AnnotationProperty ;
    rdfs:range xsd:boolean ;
    rdfs:comment "Domain is the union of owl:Class and rdf:Property, for the same reason as sq:label; see that term's comment." .

sq:facet
    a owl:AnnotationProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:boolean .

sq:indexed
    a owl:AnnotationProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:boolean .

sq:searchable
    a owl:AnnotationProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:boolean .

sq:readOnly
    a owl:AnnotationProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:boolean .

sq:displayLabel
    a owl:AnnotationProperty ;
    rdfs:domain rdf:Property ;
    rdfs:range xsd:boolean .

sq:abstract
    a owl:AnnotationProperty ;
    rdfs:domain owl:Class ;
    rdfs:range xsd:boolean .

#
# Derived properties (sq:Rollup / sq:Plugin) — Phase 4 (docs/architecture/sq-vocabulary.md,
# "Terms in use (phase 4)"). Every term below is deliberately declared owl:AnnotationProperty,
# never owl:ObjectProperty or owl:DatatypeProperty: SnapshotMapper's property attribution walks
# OntDataProperty/OntObjectProperty only, so an annotation property never surfaces as a property
# of a type — these terms describe a derivation rule attached to a property, not a property of
# the domain type themselves. Do not "fix" this by upgrading them.
#

sq:derivedBy
    a owl:AnnotationProperty ;
    rdfs:domain rdf:Property ;
    rdfs:comment "Range is really the union of sq:Rollup and sq:Plugin (a derivation is a declarative rollup or a named plugin, never both); RDFS cannot express a union range on an annotation property, so it is recorded here rather than as an rdfs:range axiom — the same limitation sq:label's comment records for its union domain. Deliberately no rdfs:range is asserted for either arm of that union: asserting just sq:Rollup (as this term once did) lets a rule-based reasoner (ReasonerSetting.OWL/RDFS) entail rdf:type sq:Rollup onto every sq:derivedBy object via the standard rdfs:range rule, including genuine sq:Plugin nodes — silently breaking SnapshotMapper's mutual-exclusion check between the two rule kinds. Presence of sq:derivedBy on a property forces PropertyDefinition.readOnly() true regardless of sq:readOnly." .

sq:Rollup
    a owl:Class ;
    rdfs:comment "A declarative aggregate: sq:function applied over instances of sq:over reached via sq:via, using sq:of as the aggregated property (absent for sq:count), optionally narrowed by sq:filter." .

sq:Plugin
    a owl:Class ;
    rdfs:comment "A derivation implemented in code and looked up by sq:pluginName via ServiceLoader against org.sequeless.spi.derivation.DerivationPlugin." .

sq:Criterion
    a owl:Class ;
    rdfs:comment "A single filter condition inside an sq:filter list: sq:property sq:operator sq:value." .

sq:function
    a owl:AnnotationProperty ;
    rdfs:domain sq:Rollup ;
    rdfs:comment "Legal values are the five function individuals declared below (sq:count, sq:sum, sq:min, sq:max, sq:avg); this is a fixed enumeration that RDFS cannot express without owl:oneOf, so no rdfs:range is asserted and the set is validated at snapshot activation instead." .

sq:over
    a owl:AnnotationProperty ;
    rdfs:domain sq:Rollup ;
    rdfs:range owl:Class .

sq:via
    a owl:AnnotationProperty ;
    rdfs:domain sq:Rollup ;
    rdfs:range rdf:Property .

sq:of
    a owl:AnnotationProperty ;
    rdfs:domain sq:Rollup ;
    rdfs:range rdf:Property ;
    rdfs:comment "Absent for sq:count." .

sq:filter
    a owl:AnnotationProperty ;
    rdfs:domain sq:Rollup ;
    rdfs:range rdf:List ;
    rdfs:comment "An RDF list of sq:Criterion nodes." .

sq:property
    a owl:AnnotationProperty ;
    rdfs:range rdf:Property ;
    rdfs:comment "Domain is the three-way union of sq:Criterion, sq:SetProperty and sq:PropertyAssignment (Phase 5 reuses this term on state-machine action nodes); RDFS rdfs:domain triples combine by intersection, not union, so asserting more than one would make a rule-based reasoner (ReasonerSetting.OWL/RDFS) infer every subject of an sq:property triple is simultaneously typed as all of them. No rdfs:domain is asserted, for the same reason sq:label's comment records for its union domain and sq:derivedBy's comment records for its union range." .

sq:operator
    a owl:AnnotationProperty ;
    rdfs:domain sq:Criterion ;
    rdfs:comment "Legal values are the eleven operator individuals declared below, mirroring org.sequeless.spi.query.Operator; this is a fixed enumeration that RDFS cannot express without owl:oneOf, so no rdfs:range is asserted and the set is validated at snapshot activation instead." .

sq:value
    a owl:AnnotationProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:comment "Absent for sq:isNull/sq:notNull (on a sq:Criterion node). Domain is the three-way union of sq:Criterion, sq:SetProperty and sq:PropertyAssignment, for the same reason as sq:property's comment; see that term's comment." .

sq:pluginName
    a owl:AnnotationProperty ;
    rdfs:domain sq:Plugin ;
    rdfs:range xsd:string .

#
# Function individuals — mirror org.sequeless.spi.meta.AggregateFunction; matched by IRI local
# name against the enum's constant names.
#

sq:count a owl:NamedIndividual .

sq:sum a owl:NamedIndividual .

sq:min a owl:NamedIndividual .

sq:max a owl:NamedIndividual .

sq:avg a owl:NamedIndividual .

#
# Operator individuals — mirror org.sequeless.spi.query.Operator; matched by IRI local name
# against the enum's constant names.
#

sq:eq a owl:NamedIndividual .

sq:ne a owl:NamedIndividual .

sq:in a owl:NamedIndividual .

sq:lt a owl:NamedIndividual .

sq:lte a owl:NamedIndividual .

sq:gt a owl:NamedIndividual .

sq:gte a owl:NamedIndividual .

sq:contains a owl:NamedIndividual .

sq:startsWith a owl:NamedIndividual .

sq:isNull a owl:NamedIndividual .

sq:notNull a owl:NamedIndividual .

#
# State machines (sq:StateMachine) — Phase 5 (docs/architecture/sq-vocabulary.md,
# "Terms in use (phase 5)"). A type's sq:appliesTo state machine declares a set of sq:state
# individuals (one sq:initialState) and an ordered sq:transition list; each sq:Transition names its
# sq:from/sq:to states, an optional sq:guard/sq:guardMessage, and an ordered sq:action list of
# sq:SetProperty / sq:CreateObject / sq:Webhook / sq:Log nodes. sq:property and sq:value (declared
# above, for sq:Criterion) are reused on sq:SetProperty and sq:PropertyAssignment nodes.
#

sq:StateMachine
    a owl:Class ;
    rdfs:comment "Attached to a type via sq:appliesTo; declares sq:initialState, sq:state (>=1) and sq:transition." .

sq:State
    a owl:Class ;
    rdfs:comment "A named state an instance of the owning type can be in; reuses sq:label/sq:displayOrder for its display name and ordering." .

sq:Transition
    a owl:Class ;
    rdfs:comment "A named move from one sq:State to another: sq:name, sq:from, sq:to, an optional sq:guard/sq:guardMessage, and an ordered sq:action list." .

sq:SetProperty
    a owl:Class ;
    rdfs:comment "A transition action that sets one property, via sq:property and either sq:value or sq:expression." .

sq:CreateObject
    a owl:Class ;
    rdfs:comment "A transition action that creates an instance of sq:type, populated from an ordered sq:properties list of sq:PropertyAssignment nodes." .

sq:PropertyAssignment
    a owl:Class ;
    rdfs:comment "One property/value pair inside a sq:CreateObject's sq:properties list: sq:property and either sq:value or sq:expression." .

sq:Webhook
    a owl:Class ;
    rdfs:comment "A transition action that calls an external sq:url with sq:method (default POST) and optional sq:body." .

sq:Log
    a owl:Class ;
    rdfs:comment "A transition action that records sq:message." .

sq:appliesTo
    a owl:AnnotationProperty ;
    rdfs:domain sq:StateMachine ;
    rdfs:range owl:Class ;
    rdfs:comment "Attaches the sq:StateMachine node to the type it governs; feeds TypeDefinition.stateMachine()." .

sq:initialState
    a owl:AnnotationProperty ;
    rdfs:domain sq:StateMachine ;
    rdfs:range sq:State .

sq:state
    a owl:AnnotationProperty ;
    rdfs:domain sq:StateMachine ;
    rdfs:range sq:State ;
    rdfs:comment "Plain multi-valued (order doesn't matter), unlike sq:transition/sq:action." .

sq:transition
    a owl:AnnotationProperty ;
    rdfs:domain sq:StateMachine ;
    rdfs:range sq:Transition ;
    rdfs:comment "Plain multi-valued (order doesn't matter), unlike sq:action." .

sq:name
    a owl:AnnotationProperty ;
    rdfs:domain sq:Transition ;
    rdfs:range xsd:string .

sq:from
    a owl:AnnotationProperty ;
    rdfs:domain sq:Transition ;
    rdfs:range sq:State .

sq:to
    a owl:AnnotationProperty ;
    rdfs:domain sq:Transition ;
    rdfs:range sq:State .

sq:trigger
    a owl:AnnotationProperty ;
    rdfs:domain sq:Transition ;
    rdfs:comment "Legal values are a fixed enumeration currently containing only sq:UserAction, which RDFS cannot express without owl:oneOf, so no rdfs:range is asserted and the set is validated at snapshot activation instead." .

sq:guard
    a owl:AnnotationProperty ;
    rdfs:domain sq:Transition ;
    rdfs:range xsd:string ;
    rdfs:comment "Absent means the transition is always available." .

sq:guardMessage
    a owl:AnnotationProperty ;
    rdfs:domain sq:Transition ;
    rdfs:range xsd:string ;
    rdfs:comment "Absent falls back to a generic guard-failure message." .

sq:action
    a owl:AnnotationProperty ;
    rdfs:domain sq:Transition ;
    rdfs:range rdf:List ;
    rdfs:comment "An RDF list of sq:SetProperty / sq:CreateObject / sq:Webhook / sq:Log nodes; order matters, mirroring sq:filter." .

sq:type
    a owl:AnnotationProperty ;
    rdfs:domain sq:CreateObject ;
    rdfs:range owl:Class .

sq:properties
    a owl:AnnotationProperty ;
    rdfs:domain sq:CreateObject ;
    rdfs:range rdf:List ;
    rdfs:comment "An RDF list of sq:PropertyAssignment nodes." .

sq:url
    a owl:AnnotationProperty ;
    rdfs:domain sq:Webhook ;
    rdfs:range xsd:string .

sq:method
    a owl:AnnotationProperty ;
    rdfs:domain sq:Webhook ;
    rdfs:range xsd:string ;
    rdfs:comment "Defaults to POST when absent." .

sq:body
    a owl:AnnotationProperty ;
    rdfs:domain sq:Webhook ;
    rdfs:range xsd:string .

sq:message
    a owl:AnnotationProperty ;
    rdfs:domain sq:Log ;
    rdfs:range xsd:string .

sq:expression
    a owl:AnnotationProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "Domain is the union of sq:SetProperty and sq:PropertyAssignment, for the same reason sq:property's comment records for its wider union; no rdfs:domain is asserted." .

sq:UserAction a owl:NamedIndividual .
