<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-build-parent</artifactId>
    <version>0.1.2</version>
    <relativePath/>
  </parent>

  <groupId>org.sequeless</groupId>
  <artifactId>sequeless-prototype</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>sequeless-prototype</name>
  <description>Root reactor POM for Sequeless. Its parent is sequeless-build-parent, which has no Spring in it,
    so sequeless-spi and sequeless-core still inherit no Spring Boot build conventions (Lombok and
    Spring must stay out of the SPI and core modules). This root imports the Spring Boot dependencies
    BOM for the adapters and the host.</description>

  <modules>
    <module>sequeless-spi</module>
    <module>sequeless-spi-testkit</module>
    <module>sequeless-core</module>
    <module>sequeless-adapter-authz-permitall</module>
    <module>sequeless-adapter-ontology-jena</module>
    <module>sequeless-adapter-persistence-postgres</module>
    <module>sequeless-adapter-expression-jexl</module>
    <module>sequeless-adapter-automation-temporal</module>
    <module>sequeless-adapter-automation-inprocess</module>
    <module>sequeless-app</module>
  </modules>

  <properties>
    <!-- An app, so 25 (#17 section 1). The parent defaults to 21 for libraries. -->
    <maven.compiler.release>25</maven.compiler.release>
    <sequeless.github.repository>sequeless-prototype</sequeless.github.repository>
    <maven.deploy.skip>true</maven.deploy.skip>
    <sonar.projectKey>sequeless_sequeless-prototype</sonar.projectKey>


    <spring-boot.version>4.1.1</spring-boot.version>
    <japicmp.version>0.26.2</japicmp.version>
    <jena.version>6.1.0</jena.version>
    <jexl.version>3.6.2</jexl.version>
    <springdoc.version>3.1.1</springdoc.version>
    <temporal.version>1.39.0</temporal.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!--
        junit-jupiter, assertj-core, mockito and testcontainers versions come from the Spring Boot
        BOM above (imported as spring-boot-dependencies) and must NOT be repinned here.
      -->

      <!--
        Convergence pins. Spring Boot's BOM does not manage these, and the dependency paths disagree.
        Each pin is the highest version any path asks for: commons-io 2.22.0 (jena-base) over 2.20.0
        (commons-csv, commons-compress); guava 33.6.0-jre (gRPC) over 33.4.8-android and
        33.6.0-android (temporal-sdk, gRPC); error_prone_annotations 2.50.0 (gRPC) over 2.41.0 and
        2.18.0.
      -->
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>2.22.0</version>
      </dependency>

      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.6.0-jre</version>
      </dependency>

      <dependency>
        <groupId>com.google.errorprone</groupId>
        <artifactId>error_prone_annotations</artifactId>
        <version>2.50.0</version>
      </dependency>

      <!--
        Jena 6 for the default OntologyPort adapter. jena-ontapi transitively brings jena-arq,
        jena-core and jena-base; it does NOT bring Jackson (Jena 6 uses gson and titanium-json-ld),
        so nothing here contends with the Spring Boot BOM. The one genuine clash is
        org.slf4j:jcl-over-slf4j, which ships the same org.apache.commons.logging classes as Boot's
        spring-jcl; it is excluded at the point of use in the adapter module rather than banned
        here, because only that module pulls it in.
      -->
      <dependency>
        <groupId>org.apache.jena</groupId>
        <artifactId>jena-ontapi</artifactId>
        <version>${jena.version}</version>
      </dependency>

      <!--
        jena-shacl backs the SHACL ValidationPort adapter (Phase 2, T8). Declared here alongside
        jena-ontapi even though T5 does not use it yet, so both Jena artifacts are pinned to the
        same ${jena.version} from one place.
      -->
      <dependency>
        <groupId>org.apache.jena</groupId>
        <artifactId>jena-shacl</artifactId>
        <version>${jena.version}</version>
      </dependency>

      <!--
        jena-core and jena-arq are used directly by sequeless-adapter-ontology-jena, but no BOM
        manages them. Pinned here so the module can declare them without a version.
      -->
      <dependency>
        <groupId>org.apache.jena</groupId>
        <artifactId>jena-core</artifactId>
        <version>${jena.version}</version>
      </dependency>

      <dependency>
        <groupId>org.apache.jena</groupId>
        <artifactId>jena-arq</artifactId>
        <version>${jena.version}</version>
      </dependency>

      <!--
        springdoc 3.x is the Spring Boot 4 line (3.1.1 builds against spring-boot-starter-parent
        4.1.0); the 2.x line targets Boot 3 and will not bind here.
      -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>

      <!--
        Commons JEXL 3 for the default ExpressionPort adapter. 3.6.2 is the latest stable 3.x on
        Maven Central (verified during Phase 5 T5). JEXL has very few transitive dependencies and
        pulls in no Jackson/logging library that would contend with the Spring Boot BOM above.
      -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-jexl3</artifactId>
        <version>${jexl.version}</version>
      </dependency>

      <!--
        Temporal Java SDK for the default AutomationPort adapter (sequeless-adapter-automation-
        temporal), 1.39.0 verified as the latest stable 1.x on Maven Central as of Phase 5 T10.
        temporal-spring-boot-starter is deliberately NOT used here: verified (mvn dependency:tree)
        that it transitively pulls Spring Boot 2.7.18 (spring-boot-starter/spring-boot-
        autoconfigure 2.7.18), incompatible with this project's Boot 4.1.1 line and a real risk of
        NoSuchMethodError/ClassNotFoundException from stale bytecode even after dependencyManagement
        force-upgrades the jar versions. This adapter hand-rolls its own @AutoConfiguration against
        the dependency-free temporal-sdk instead, exactly like every other adapter in this repo.
      -->
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-sdk</artifactId>
        <version>${temporal.version}</version>
      </dependency>

      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-testing</artifactId>
        <version>${temporal.version}</version>
      </dependency>

      <!--
        Used directly by sequeless-adapter-automation-temporal. No BOM manages it, so it is pinned
        here at the same version as temporal-sdk.
      -->
      <dependency>
        <groupId>io.temporal</groupId>
        <artifactId>temporal-serviceclient</artifactId>
        <version>${temporal.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    Maven resolves the parent before it reads the parent's own repositories, so the GitHub Packages
    repository is repeated here. Consumers of sequeless-build-parent need a read:packages token.
  -->
  <repositories>
    <repository>
      <id>github</id>
      <url>https://maven.pkg.github.com/sequeless/*</url>
    </repository>
  </repositories>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          Full japicmp configuration lives here so a bare <plugin> declaration in a module's own
          <build><plugins> (e.g. sequeless-spi) inherits both this configuration and the
          japicmp-verify execution bound to the verify phase. No sequeless-spi artifact has ever
          been published, so oldVersion RELEASE fails to resolve; ignoreMissingOldVersion makes
          that a skipped no-op today. This becomes a real compatibility gate once an SPI GA is
          published. The parent has no japicmp, so this stays here.
        -->
        <plugin>
          <groupId>com.github.siom79.japicmp</groupId>
          <artifactId>japicmp-maven-plugin</artifactId>
          <version>${japicmp.version}</version>
          <configuration>
            <oldVersion>
              <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>${project.artifactId}</artifactId>
                <version>RELEASE</version>
                <type>jar</type>
              </dependency>
            </oldVersion>
            <newVersion>
              <file>
                <path>${project.build.directory}/${project.build.finalName}.${project.packaging}</path>
              </file>
            </newVersion>
            <parameter>
              <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
              <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
              <onlyBinaryIncompatible>true</onlyBinaryIncompatible>
            </parameter>
          </configuration>
          <executions>
            <execution>
              <id>japicmp-verify</id>
              <goals>
                <goal>cmp</goal>
              </goals>
              <phase>verify</phase>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <!--
      The parent binds dependency:analyze-only to verify, with failOnWarning. Spring Boot starters
      carry auto-configuration and are never named in code, so they are ignored as unused
      (spec 3 section 3.2a, rule 2).
    -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>analyze-only</id>
            <configuration>
              <ignoredUnusedDeclaredDependencies>
                <ignoredUnusedDeclaredDependency>org.springframework.boot:spring-boot-starter*</ignoredUnusedDeclaredDependency>
              </ignoredUnusedDeclaredDependencies>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
