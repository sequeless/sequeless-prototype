<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sequeless</groupId>
    <artifactId>sequeless-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>sequeless-adapter-automation-temporal</artifactId>

  <name>sequeless-adapter-automation-temporal</name>
  <description>
    The default, durable AutomationPort adapter: the Temporal Java SDK drives an ActionWorkflow per
    ActionRequest outbox entry, dispatching to ActionExecutor-backed activities with configurable
    retry.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-spi</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Version comes from the root dependencyManagement (${temporal.version}). This adapter's own
         core library, declared non-optionally exactly like commons-jexl3 in the Jexl adapter -
         see the root pom's dependencyManagement comment for why temporal-spring-boot-starter is
         deliberately not used instead. -->
    <dependency>
      <groupId>io.temporal</groupId>
      <artifactId>temporal-sdk</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>

    <!--
      Brings AutomationContract and RecordingActionExecutor and (transitively, at compile scope
      there by design) JUnit Jupiter and AssertJ.
    -->
    <dependency>
      <groupId>org.sequeless</groupId>
      <artifactId>sequeless-spi-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
      TemporalAutomationAutoConfigurationTest uses ApplicationContextRunner, mirroring
      sequeless-adapter-expression-jexl's JexlExpressionAutoConfigurationTest.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      TestWorkflowEnvironment: an in-memory Temporal test service, no live server or Testcontainers
      required, used by TemporalAutomationPortContractTest.
    -->
    <dependency>
      <groupId>io.temporal</groupId>
      <artifactId>temporal-testing</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
