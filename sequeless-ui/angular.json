          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ui-kit/tsconfig.spec.json",
            "runnerConfig": "projects/ui-kit/vitest.config.mts"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/ui-kit/**/*.ts", "projects/ui-kit/**/*.html"],
            "eslintConfig": "projects/ui-kit/eslint.config.js"
          }
        }
      }
    },
    "objects": {
      "projectType": "library",
      "root": "projects/objects",
      "sourceRoot": "projects/objects/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/objects/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/objects/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/objects/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/objects/**/*.ts", "projects/objects/**/*.html"],
            "eslintConfig": "projects/objects/eslint.config.js"
          }
        }
      }
    },
    "ontology": {
      "projectType": "library",
      "root": "projects/ontology",
      "sourceRoot": "projects/ontology/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ontology/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ontology/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ontology/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/ontology/**/*.ts", "projects/ontology/**/*.html"],
            "eslintConfig": "projects/ontology/eslint.config.js"
          }
        }
      }
    },
    "automation": {
      "projectType": "library",
      "root": "projects/automation",
      "sourceRoot": "projects/automation/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/automation/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/automation/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/automation/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/automation/**/*.ts", "projects/automation/**/*.html"],
            "eslintConfig": "projects/automation/eslint.config.js"
          }
        }
      }
    },
    "testing": {
      "projectType": "library",
      "root": "projects/testing",
      "sourceRoot": "projects/testing/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/testing/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/testing/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/testing/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/testing/**/*.ts", "projects/testing/**/*.html"],
            "eslintConfig": "projects/testing/eslint.config.js"
          }
        }
      }
    }
  }
}
